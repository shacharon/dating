# Copy to `dating-ui/.env.local` (Next.js loads `.env.local` automatically in this folder only).
# Do NOT put NEXT_PUBLIC_* in dating-api — the browser reads env from the UI app.
#
# Local dev: start dating-api on port 3001 BEFORE the UI, or use repo root `npm run dev`.
# See ../DEV.md — UI proxies /api to http://127.0.0.1:3001 (API_PROXY_TARGET in next.config).

# Required for Google Sign-In (GIS). Use the same Web "OAuth client ID" string as
# `GOOGLE_CLIENT_ID` in `dating-api/.env` (Google Cloud Console → APIs & Services → Credentials).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# API origin for browser fetches (session cookie is HttpOnly on this host).
# Example: http://localhost:3001
# Prefer leaving unset locally so the UI uses same-origin `/api` (cookie-safe photo `<img>`).
NEXT_PUBLIC_API_URL=

# Optional: hosts allowed for real next/image optimization (comma-separated).
# Supports suffix wildcards, e.g. `*.cloudfront.net,cdn.example.com`.
# AuthGuard Nest photo `/api/.../file` URLs must NOT be listed — optimizer has no session cookie.
# When unset, MatchPhoto never optimizes (safe for local/dev).
# NEXT_PUBLIC_PHOTO_CDN_HOSTS=

# Optional: must match the API session cookie name if not default.
# NEXT_PUBLIC_SESSION_COOKIE_NAME=dating_session

# Real-time messaging: `ws` (socket.io push) or `poll` (Sprint 3 interval).
# Default when unset: **ws** (Sprint 29). Set `poll` for local poll-only or emergency rollback.
# Flag is build-time — flip requires UI rebuild/redeploy (not a runtime toggle).
# NEXT_PUBLIC_REALTIME=poll
#
# Socket.io connects directly to the API (bypasses Next `/socket.io` rewrite — WS upgrade is flaky in dev).
# When NEXT_PUBLIC_API_URL is unset, origin is `http://<ui-host>:3001` (same host as the UI for cookies).
# NEXT_PUBLIC_API_PORT=3001

# Optional: gate test-only routes in development.
# NEXT_PUBLIC_AUTH_TEST=1

# Admin UI (Sprint 11 Story 0): in production builds, /admin returns 404 unless set to 1.
# Use only on network-gated staging/admin hosts — see dating-api/docs/ops/ADMIN_ACCESS.md
# NEXT_PUBLIC_ADMIN_ENABLED=1

# Optional: external link for match quality runbook on /admin/match-quality empty state
# NEXT_PUBLIC_MATCH_QUALITY_RUNBOOK_URL=

# Beta support mailto target for /support (Sprint 43 Story 4).
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# --- Sentry (Sprint 5 Story 2) ---
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
