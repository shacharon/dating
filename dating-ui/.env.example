# Copy to `dating-ui/.env.local` (Next.js loads `.env.local` automatically in this folder only).
# Do NOT put NEXT_PUBLIC_* in dating-api — the browser reads env from the UI app.

# Required for Google Sign-In (GIS). Use the same Web "OAuth client ID" string as
# `GOOGLE_CLIENT_ID` in `dating-api/.env` (Google Cloud Console → APIs & Services → Credentials).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# API origin for browser fetches (session cookie is HttpOnly on this host).
# Example: http://localhost:3001
NEXT_PUBLIC_API_URL=

# Optional: must match the API session cookie name if not default.
# NEXT_PUBLIC_SESSION_COOKIE_NAME=dating_session

# Real-time messaging: `ws` (socket.io push) or `poll` (Sprint 3 interval). Default: poll.
# Staging/prod rollout: set to `ws` only after Sprint 5 smoke gate passes — requires UI rebuild/redeploy.
# NEXT_PUBLIC_REALTIME=ws
#
# Socket.io connects directly to the API (bypasses Next `/socket.io` rewrite — WS upgrade is flaky in dev).
# When NEXT_PUBLIC_API_URL is unset, origin is `http://<ui-host>:3001` (same host as the UI for cookies).
# NEXT_PUBLIC_API_PORT=3001

# Optional: gate test-only routes in development.
# NEXT_PUBLIC_AUTH_TEST=1

# --- Sentry (Sprint 5 Story 2) ---
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
