{
  "name": "dating-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx next dev --turbopack -p 3000",
    "dev:fresh": "node scripts/clean-next.cjs && npx next dev --turbopack -p 3000",
    "dev:turbopack": "npx next dev --turbopack -p 3000",
    "dev:webpack": "npx next dev --webpack -p 3000",
    "dev:safe": "node ../scripts/wait-for-api.mjs && npm run dev",
    "dev:webpack:safe": "node ../scripts/wait-for-api.mjs && npm run dev:webpack",
    "dev:nowait": "npx next dev --webpack -p 3000",
    "clean:next": "node scripts/clean-next.cjs",
    "build": "next build",
    "build:capacitor": "cross-env CAPACITOR_BUILD=1 next build && node scripts/post-cap-export.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:e2e": "vitest run \"src/app/(authenticated)/profile/page.spec.tsx\" src/app/profile-route-redirects.spec.tsx",
    "test:watch": "vitest",
    "validate:phase2-me-profile": "vitest run src/lib/me-profile-api.spec.ts src/lib/profile-form.spec.ts src/lib/phase25-profile-enrichment.spec.ts src/middleware.spec.ts",
    "cap:prepare-webdir": "node scripts/prepare-cap-webdir.mjs",
    "cap:sync": "npm run build:capacitor && npx cap sync",
    "cap:sync:android": "npm run build:capacitor && npx cap sync android",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.8",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@sentry/nextjs": "^10.56.0",
    "@tanstack/react-query": "^5.101.4",
    "jwt-decode": "^4.0.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
