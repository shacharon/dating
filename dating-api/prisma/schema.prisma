generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum UserProfileStatus {
  DRAFT
  SUBMITTED
  ANALYZING
  ANALYZED
  FAILED
}

enum ProfileGender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  googleId    String     @unique
  displayName String?
  avatarUrl   String?
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  profile  UserProfile?
  sessions UserSession[]
}

model UserProfile {
  id                    String            @id @default(cuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id])
  name                  String            @default("")
  status                UserProfileStatus @default(DRAFT)
  onboardingStep        Int               @default(1)
  aboutMe               String?
  aboutPartner          String?
  aboutRelationship     String?
  birthDate             DateTime?
  gender                ProfileGender
  desiredPartnerGenders Json?
  city                  String?
  country               String?
  locationLabel         String?
  submittedAt           DateTime?
  analyzedAt            DateTime?
  lastAnalysisError     String?

  // ── Holy Grail structured facts (self) ─────────────────────────────────────
  childrenStatus          String?
  wantsChildren           String?
  smokingFrequency        String?
  alcoholUse              String?
  education               String?
  religion                String?

  // ── Holy Grail structured preferences (partner requirements) ───────────────
  partnerAgeMin            Int?
  partnerAgeMax            Int?
  minimumPartnerEducation  String?
  acceptedPartnerSmoking   String[] @default([])
  acceptedPartnerAlcohol   String[] @default([])
  partnerWantsChildren     String?
  partnerHasChildren       String?
  acceptedPartnerReligions String[] @default([])
  maxDistanceKm            Int?
  similarityPreference     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluations UserProfileEvaluation[]
}

/**
 * Append-safe analysis output for a UserProfile.
 * One row is created per successful analysis run; multiple rows per profile are allowed.
 * Latest-evaluation rule: ORDER BY createdAt DESC LIMIT 1.
 */
model UserProfileEvaluation {
  id             String      @id @default(cuid())
  profileId      String
  profile        UserProfile @relation(fields: [profileId], references: [id])
  version        String
  evaluationJson Json

  createdAt DateTime @default(now())

  @@index([profileId, createdAt(sort: Desc)])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime?
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())
}
