# Copy to `.env` in this folder (dating-api). Prisma and Nest load it via dotenv / ConfigModule.

# Required — PostgreSQL connection string used by PrismaService.
# Pool params are per Node process (local start:dev, each ECS API task, one-shot migrate).
#   connection_limit=10 — max connections in this process's Prisma pool (recommended).
#   pool_timeout=10 — seconds to wait for a free connection before erroring.
# Omit pool params → Prisma default (~num_cpus*2+1). Fine for single-process local; use explicit
# values before multi-task AWS. See docs/ops/PRISMA_CONNECTION_POOL.md.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public&connection_limit=10&pool_timeout=10"

# Optional — Nest HTTP port (default 3001).
PORT=3001

# Optional — append structured JSON observability lines (auth/me-profile, etc.) to a local file in addition to stdout.
# When unset and NODE_ENV=development, defaults to logs/dating-api.log (directory created as needed).
# Set to 0, false, or off to disable the file sink. Writes are best-effort: if the path is missing or not writable (e.g. in AWS), only stdout is used.
# STRUCTURED_LOG_FILE=logs/dating-api.log

# --- Google Sign-In (GIS id_token → session cookie) ---
# Public OAuth client ID from Google Cloud Console (Web application). Used to verify `id_token` audience.
# The Next.js app must also set the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in dating-ui/.env.local.
GOOGLE_CLIENT_ID=

# --- HttpOnly session cookie + server-side session row ---
# Cookie name sent to the browser (default: dating_session).
SESSION_COOKIE_NAME=dating_session

# Secret pepper for hashing opaque session tokens before DB storage. Generate a long random string; never commit real values.
SESSION_SECRET_PEPPER=

# Session lifetime in whole days (default: 14).
SESSION_TTL_DAYS=14

# Optional — Cookie Domain (e.g. .example.com). Leave unset for host-only cookies in local dev.
# COOKIE_DOMAIN=

# Cookie Secure flag: set true in production behind HTTPS (values: 1, true, yes, on).
COOKIE_SECURE=false

# --- CORS ---
# Comma-separated allowed browser origins (exact match). Defaults to localhost dev URLs if unset.
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Credentialed CORS for HttpOnly session cookies (Next.js on another port). Default in code is true if unset; set false only if you intentionally disable cross-origin cookies.
CORS_CREDENTIALS=true

# --- Email notifications (Sprint 6) — provider: Resend ---
# Local dev: leave EMAIL_PROVIDER unset or `disabled` → noop (no sends, trace only).
# Production: verify your dating domain in Resend, then set the block below.
# Setup checklist: dating-api/docs/EMAIL_RESEND_SETUP.md
#
# EMAIL_PROVIDER=disabled
#
# --- Production (uncomment when domain + Resend are ready) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# Project domain (verified in Resend): going2eat.food
# EMAIL_FROM=Piza <notifications@going2eat.food>
# APP_PUBLIC_URL=http://localhost:3000
# Prod: APP_PUBLIC_URL=https://app.going2eat.food (when dating UI is deployed there)
# EMAIL_UNSUBSCRIBE_SECRET=generate-a-long-random-string-min-32-chars
# EMAIL_MESSAGE_DEBOUNCE_MINUTES=15

# --- Sentry (Sprint 5 Story 2) ---
# Optional locally; set in staging/production. Never commit real DSN values.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_PROFILES_SAMPLE_RATE=0
# ENABLE_SENTRY_TEST=1

# --- Product funnel analytics (Sprint 7 Story 4) ---
# Emit structured JSON lines with logKind=product_analytics (default: enabled).
# PRODUCT_ANALYTICS_ENABLED=false
# Optional pepper for conversationId hashing (recommended in production).
# PRODUCT_ANALYTICS_HASH_SALT=

# --- User reports (Sprint 9 Story 4) ---
# Optional ops inbox for new user reports (plain-text alert). Unset = no ops email.
# REPORT_OPS_EMAIL=ops@example.com

# --- Admin ops (Sprint 10 Stories 2–3; hardened Sprint 11 Story 0) ---
# Comma-separated User.id values allowed to call /api/v1/admin/* and use /admin UI.
# On public hosts, also restrict /api/v1/admin/* at WAF/VPN — see docs/ops/ADMIN_ACCESS.md.
# ADMIN_USER_IDS=

# --- Redis (socket.io adapter, WS rate limit, match-list cache, Bull) ---
# Unset = single-instance / fail-open (no shared cache; analysis runs inline).
# REDIS_URL=redis://127.0.0.1:6379
# Temporary hydrate cap on legacy escape hatch only (MATCH_LIST_MATERIALIZED=0). Default 1000.
# MATCH_LIST_CANDIDATE_CAP=1000
# Rebuild job hydrate bound — caps MatchListRank membership per rebuild; raise for fairness. Default 5000.
# MATCH_LIST_REBUILD_CANDIDATE_CAP=5000
# Serve GET /me/matches from MatchListRank (Sprint 31 Story 5). Default ON when unset; set 0/false/no for legacy.
# MATCH_LIST_MATERIALIZED=1
# MATCH_LIST_MATERIALIZED=0
# Delay ms between backfill enqueues (scripts/enqueue-match-list-rank-backfill.ts). Default 200.
# MATCH_LIST_BACKFILL_DELAY_MS=200

# --- Photo storage ---
# PHOTO_STORAGE_DRIVER=local
# PHOTO_UPLOAD_DIR=uploads/profile-photos
# PHOTO_STORAGE_DRIVER=s3
# PHOTO_S3_BUCKET=
# PHOTO_S3_REGION=us-east-1
# PHOTO_S3_PREFIX=profile-photos
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Photo CDN (signed CloudFront URLs; off by default) ---
# PHOTO_CDN_ENABLED=0
# PHOTO_CDN_DOMAIN=d123.cloudfront.net
# PHOTO_CDN_KEY_PAIR_ID=
# PHOTO_CDN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# PHOTO_CDN_URL_TTL_SECONDS=3600

# --- Datadog APM (optional; requires `npm i dd-trace`) ---
# DD_TRACE_ENABLED=0
# DD_API_KEY=
# DD_SERVICE=dating-api
# DD_ENV=development
# DD_TRACE_SAMPLE_RATE=1

# --- Photo moderation (Sprint 10 Story 2 + Sprint 19 Story 2) ---
# Default when unset: mock (local auto-approve) if no AWS keys; rekognition if AWS keys present.
# PHOTO_MODERATION_DRIVER=mock
# PHOTO_MODERATION_DRIVER=rekognition
# PHOTO_MODERATION_DRIVER=stub
# PHOTO_FACE_DETECTION_ENABLED=1
# NSFW_FLAG_THRESHOLD=50
# NSFW_AUTO_REJECT_THRESHOLD=80
# PHOTO_MODERATION_SLA_LOW_HOURS=6
# PHOTO_MODERATION_SLA_MAX_HOURS=24
# PHOTO_MODERATION_SLA_LOW_CONFIDENCE=60
# PHOTO_MODERATION_SLA_ALERT_PER_DAY=20
# PHOTO_MODERATION_ML_STUCK_MINUTES=15
# Dev only — never in production (skips ML entirely):
# PHOTO_MODERATION_AUTO_APPROVE=1

# --- Content moderation (Sprint 30) ---
# OpenAI Moderation API for profile text + messages (Stories 02–03 gates).
# Unset or true = enabled. Set false/0/off to skip gates locally.
# CONTENT_MODERATION_ENABLED=true
# Uses existing OPENAI_API_KEY.

# POST /api/v1/auth/google { "idToken" } → Set-Cookie + JSON user; GET /api/v1/auth/me; POST /api/v1/auth/logout

# Optional — enable POST /api/v1/matches/compare/hg-diagnostic when set to 1 or true.
# ENABLE_HG_COMPARE_DIAGNOSTIC=1
