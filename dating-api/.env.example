# Copy to `.env` in this folder (dating-api). Prisma and Nest load it via dotenv / ConfigModule.

# Required — PostgreSQL connection string used by PrismaService.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# Optional — Nest HTTP port (default 3001).
PORT=3001

# Optional — append structured JSON observability lines (auth/me-profile, etc.) to a local file in addition to stdout.
# When unset and NODE_ENV=development, defaults to logs/dating-api.log (directory created as needed).
# Set to 0, false, or off to disable the file sink. Writes are best-effort: if the path is missing or not writable (e.g. in AWS), only stdout is used.
# STRUCTURED_LOG_FILE=logs/dating-api.log

# --- Google Sign-In (GIS id_token → session cookie) ---
# Public OAuth client ID from Google Cloud Console (Web application). Used to verify `id_token` audience.
# The Next.js app must also set the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in dating-ui/.env.local.
GOOGLE_CLIENT_ID=

# --- HttpOnly session cookie + server-side session row ---
# Cookie name sent to the browser (default: dating_session).
SESSION_COOKIE_NAME=dating_session

# Secret pepper for hashing opaque session tokens before DB storage. Generate a long random string; never commit real values.
SESSION_SECRET_PEPPER=

# Session lifetime in whole days (default: 14).
SESSION_TTL_DAYS=14

# Optional — Cookie Domain (e.g. .example.com). Leave unset for host-only cookies in local dev.
# COOKIE_DOMAIN=

# Cookie Secure flag: set true in production behind HTTPS (values: 1, true, yes, on).
COOKIE_SECURE=false

# --- CORS ---
# Comma-separated allowed browser origins (exact match). Defaults to localhost dev URLs if unset.
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Credentialed CORS for HttpOnly session cookies (Next.js on another port). Default in code is true if unset; set false only if you intentionally disable cross-origin cookies.
CORS_CREDENTIALS=true

# --- Cookie session HTTP ---
# POST /api/v1/auth/google { "idToken" } → Set-Cookie + JSON user; GET /api/v1/auth/me; POST /api/v1/auth/logout

# Optional — enable POST /api/v1/matches/compare/hg-diagnostic when set to 1 or true.
# ENABLE_HG_COMPARE_DIAGNOSTIC=1
