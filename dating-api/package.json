{
  "name": "dating-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "smoke:matches": "jest src/matches/matches-api-smoke.integration.spec.ts --runInBand",
    "smoke:me-profile": "jest src/me-profile/me-profile-http.integration.spec.ts --runInBand",
    "validate:phase2-me-profile": "jest src/me-profile/me-profile.service.spec.ts src/me-profile/me-profile-http.integration.spec.ts src/me-profile/dto/me-profile-writable-fields.dto.spec.ts src/me-profile/user-profile-matching-bridge.contract.spec.ts --runInBand",
    "smoke:auth": "jest --runInBand src/auth/auth-http.integration.spec.ts src/session/session-token.crypto.spec.ts src/session/session.service.spec.ts src/users/users.service.spec.ts src/auth/google-auth.service.spec.ts src/auth/auth.service.spec.ts src/auth/optional-auth.guard.spec.ts src/auth/prisma-auth.errors.spec.ts",
    "validate:v1-v2": "nest build && node dist/src/validate-v1-v2.js",
    "holy-grail:backfill": "ts-node src/holy-grail-matching/backfill-holy-grail-structured.ts",
    "ci:hg-ranking-guard": "ts-node scripts/hg-ranking-signal-ci-guard.ts",
    "seed:lifestyle-v2-validation": "ts-node scripts/seed-lifestyle-v2-validation.ts",
    "seed:personality-v2-validation": "ts-node scripts/seed-personality-v2-validation.ts",
    "validate:personality-v2": "ts-node scripts/validate-personality-v2.ts",
    "seed:interest-v2-validation": "ts-node scripts/seed-interest-v2-validation.ts",
    "seed:interest-tags-v2-validation": "ts-node scripts/seed-interest-tags-v2-validation.ts",
    "validate:interest-v2": "ts-node scripts/validate-interest-v2.ts",
    "validate:interest-tags-v2": "ts-node scripts/validate-interest-tags-v2.ts",
    "validate:lifestyle-v2": "ts-node scripts/validate-lifestyle-signals-v2.ts",
    "batch:signal-families": "ts-node scripts/v1-signal-families-batch-analysis.ts",
    "lifestyle-v2:db-report": "ts-node scripts/lifestyle-v2-db-report.ts",
    "seed:hg-validation-minimal": "ts-node scripts/ci-seed-hg-validation-minimal.ts",
    "verify:personality-traits": "ts-node scripts/personality-traits-e2e-verify.ts",
    "audit:hg-strong-low-evidence": "ts-node --transpile-only scripts/hg-strong-low-evidence-audit.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "6.19.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "google-auth-library": "^10.6.2",
    "openai": "^6.25.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.8.1",
    "prisma": "6.19.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "@prisma/client": "6.19.2",
    "prisma": "6.19.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
